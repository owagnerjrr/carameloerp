{
  "name": "caramelo-erp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @caramelo/api\" \"npm run dev -w @caramelo/web\"",
    "db:generate": "npm run generate -w @caramelo/database",
    "db:migrate": "npm run migrate -w @caramelo/database",
    "db:seed": "npm run seed -w @caramelo/database",
    "db:local": "node scripts/local-postgres.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "lint": "eslint . && npm run typecheck",
    "typecheck": "tsc --noEmit -p apps/api && tsc --noEmit -p apps/web && tsc --noEmit -p tests",
    "test": "vitest run",
    "build": "npm run db:generate && npm run build -w @caramelo/api && npm run build -w @caramelo/web",
    "check": "npm run lint && npm test && npm run build",
    "test:db": "node scripts/test-database.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "dotenv": "^17.2.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.2",
    "@playwright/test": "^1.56.0",
    "embedded-postgres": "18.4.0-beta.17",
    "rolldown": "^1.0.0",
    "prettier": "^3.6.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4",
    "esbuild": "^0.28.2"
  }
}
