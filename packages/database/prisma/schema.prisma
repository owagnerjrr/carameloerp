generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}
datasource db {
  provider = "postgresql"
}

model Company {
  financialCategories FinancialCategory[]
  financialObligations FinancialObligation[]
  purchaseOrders PurchaseOrder[]
  events Event[]

  creditMovements CustomerCreditMovement[]
  cashSessions CashSession[]
  returns ReturnOperation[]
  credits CustomerCredit[]

  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  branches Branch[]
  memberships Membership[]
  roles Role[]
  customers Customer[]
  suppliers Supplier[]
  categories Category[]
  products Product[]
  warehouses Warehouse[]
  sales Sale[]
  financialEntries FinancialEntry[]
  bankAccounts BankAccount[]
  cashRegisters CashRegister[]
  fiscalDocuments FiscalDocument[]
  auditLogs AuditLog[]
}
model Branch {
  financialObligations FinancialObligation[]
  purchaseOrders PurchaseOrder[]
  events Event[]

  cashSessions CashSession[]
  returns ReturnOperation[]

  financialEntries FinancialEntry[]
  cashRegisters CashRegister[]
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  name String
  company Company @relation(fields:[companyId], references:[id])
  memberships Membership[]
  warehouses Warehouse[]
  sales Sale[]
  @@unique([companyId,id])
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  name String
  passwordHash String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  memberships Membership[]
}
model Permission {
  code String @id
  description String
  roles RolePermission[]
}
model Role {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  name String
  company Company @relation(fields:[companyId],references:[id])
  permissions RolePermission[]
  memberships Membership[]
  @@unique([companyId,id])
  @@unique([companyId,name])
}
model RolePermission {
  roleId String @db.Uuid
  permissionCode String
  role Role @relation(fields:[roleId],references:[id],onDelete:Cascade)
  permission Permission @relation(fields:[permissionCode],references:[code])
  @@id([roleId,permissionCode])
}
model Membership {
  financialSettlements FinancialSettlement[]
  financialActions FinancialAction[]
  financialObligations FinancialObligation[]
  purchasesCreated PurchaseOrder[] @relation("PurchaseCreator")
  purchasesAssigned PurchaseOrder[] @relation("PurchaseBuyer")
  purchasesApproved PurchaseOrder[] @relation("PurchaseApprover")
  purchaseActions PurchaseAction[]
  responsibleEvents Event[]
  eventDocuments EventDocument[]

  creditMovements CustomerCreditMovement[]
  openedCashSessions CashSession[] @relation("CashOpener")
  closedCashSessions CashSession[] @relation("CashCloser")
  cashMovements CashMovement[]
  returns ReturnOperation[]

  stockDocuments StockDocument[]
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  userId String @db.Uuid
  roleId String @db.Uuid
  branchId String? @db.Uuid
  active Boolean @default(true)
  company Company @relation(fields:[companyId],references:[id])
  user User @relation(fields:[userId],references:[id])
  role Role @relation(fields:[companyId,roleId],references:[companyId,id])
  branch Branch? @relation(fields:[companyId,branchId],references:[companyId,id])
  sessions Session[]
  sales Sale[] @relation("SaleSeller")
  cancelledSales Sale[] @relation("SaleCanceller")
  stockMovements StockMovement[]
  auditLogs AuditLog[]
  @@unique([companyId,id])
  @@unique([companyId,userId])
  @@index([userId])
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  membershipId String @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  membership Membership @relation(fields:[membershipId],references:[id],onDelete:Cascade)
  @@index([expiresAt])
  @@index([membershipId])
}
model Customer {
  creditMovements CustomerCreditMovement[]
  returns ReturnOperation[]
  credits CustomerCredit[]

  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  name String
  document String?
  registration String?
  phone String?
  whatsapp String?
  email String?
  postalCode String?
  street String?
  number String?
  complement String?
  district String?
  city String?
  state String?
  notes String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields:[companyId],references:[id])
  sales Sale[]
  financialEntries FinancialEntry[]
  @@unique([companyId,id])
  @@unique([companyId,document])
  @@index([companyId,name])
  @@index([companyId,createdAt])
}
model Supplier {
  financialObligations FinancialObligation[]
  purchaseOrders PurchaseOrder[]
  tradeName String?
  type String @default("OTHER")
  website String?
  contact String?
  deliveryDays Int?
  paymentTerms String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stockDocuments StockDocument[]
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  name String
  document String?
  registration String?
  phone String?
  whatsapp String?
  email String?
  postalCode String?
  street String?
  number String?
  complement String?
  district String?
  city String?
  state String?
  notes String?
  active Boolean @default(true)
  company Company @relation(fields:[companyId],references:[id])
  products Product[]
  financialEntries FinancialEntry[]
  @@unique([companyId,id])
  @@unique([companyId,document])
}
model Category {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  name String
  company Company @relation(fields:[companyId],references:[id])
  products Product[]
  @@unique([companyId,id])
  @@unique([companyId,name])
}
model Product {
  purchaseItems PurchaseOrderItem[]
  purchaseDivergences PurchaseDivergence[]
  eventItems EventDocumentItem[]

  stockDocumentItems StockDocumentItem[]
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  code String
  barcode String?
  subtitle String?
  isbn10 String?
  isbn13 String?
  author String?
  coauthor String?
  publisher String?
  imprint String?
  edition String?
  publicationYear Int?
  language String?
  genre String?
  pages Int?
  format String?
  coverType String?
  weightGrams Int?
  dimensions String?
  coverUrl String?
  synopsis String?
  identifiers ProductIdentifier[]
  description String
  categoryId String? @db.Uuid
  supplierId String? @db.Uuid
  brand String?
  unit String @default("UN")
  cost Decimal @default(0) @db.Decimal(14,2)
  price Decimal @db.Decimal(14,2)
  minStock Decimal @default(0) @db.Decimal(14,3)
  location String?
  ncm String?
  cest String?
  cfop String?
  origin String?
  cst String?
  csosn String?
  taxProfile Json?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields:[companyId],references:[id])
  category Category? @relation(fields:[companyId,categoryId],references:[companyId,id])
  supplier Supplier? @relation(fields:[companyId,supplierId],references:[companyId,id])
  balances StockBalance[]
  movements StockMovement[]
  saleItems SaleItem[]
  @@unique([companyId,id])
  @@unique([companyId,code])
  @@unique([companyId,barcode])
  @@index([companyId,description])
  @@index([companyId,author])
  @@index([companyId,publisher])
}
model Warehouse {
  kind String @default("STANDARD")
  event Event? @relation("EventStock")
  transitEvent Event? @relation("EventTransit")
  eventOrigins EventDocument[]

  returns ReturnOperation[]

  sales Sale[]
  stockDocuments StockDocument[]
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  branchId String @db.Uuid
  name String
  company Company @relation(fields:[companyId],references:[id])
  branch Branch @relation(fields:[companyId,branchId],references:[companyId,id])
  balances StockBalance[]
  movements StockMovement[]
  @@unique([companyId,id])
}
model StockBalance {
  minStock Decimal? @db.Decimal(14,3)
  location String?
  companyId String @db.Uuid
  warehouseId String @db.Uuid
  productId String @db.Uuid
  quantity Decimal @default(0) @db.Decimal(14,3)
  warehouse Warehouse @relation(fields:[companyId,warehouseId],references:[companyId,id])
  product Product @relation(fields:[companyId,productId],references:[companyId,id])
  @@id([companyId,warehouseId,productId])
  @@index([companyId,productId])
}
enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
}
model StockMovement {
  eventDocumentId String? @db.Uuid
  eventDocument EventDocument? @relation(fields:[companyId,eventDocumentId],references:[companyId,id])
  @@unique([companyId,eventDocumentId,warehouseId,productId])

  returnId String? @db.Uuid
  returnOperation ReturnOperation? @relation(fields:[companyId,returnId],references:[companyId,id])
  @@unique([companyId,returnId,productId,type])

 saleId String? @db.Uuid
 sale Sale? @relation(fields:[companyId,saleId],references:[companyId,id])
 @@unique([companyId,saleId,productId,type])
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  warehouseId String @db.Uuid
  productId String @db.Uuid
  actorId String @db.Uuid
  type StockMovementType
  quantity Decimal @db.Decimal(14,3)
  reason String
  transferGroup String? @db.Uuid
  beforeQuantity Decimal? @db.Decimal(14,3)
  afterQuantity Decimal? @db.Decimal(14,3)
  documentId String? @db.Uuid
  document StockDocument? @relation(fields:[companyId,documentId],references:[companyId,id])
  createdAt DateTime @default(now())
  warehouse Warehouse @relation(fields:[companyId,warehouseId],references:[companyId,id])
  product Product @relation(fields:[companyId,productId],references:[companyId,id])
  actor Membership @relation(fields:[companyId,actorId],references:[companyId,id])
  @@index([companyId,createdAt])
  @@index([companyId,productId])
}
enum SaleStatus {
  QUOTE
  ORDER
  COMPLETED
  CANCELLED
  RETURNED
}
model Sale {
  creditMovements CustomerCreditMovement[]
  cashSessionId String? @db.Uuid
  exchangeCredit Decimal @default(0) @db.Decimal(14,2)
  cashSession CashSession? @relation(fields:[companyId,cashSessionId],references:[companyId,id])
  returns ReturnOperation[] @relation("OriginalSale")
  exchangeOrigin ReturnOperation? @relation("ReplacementSale")

 warehouseId String? @db.Uuid
 requestKey String? @db.Uuid
 requestHash String?
 subtotal Decimal? @db.Decimal(14,2)
 cancelledAt DateTime?
 cancelReason String?
 cancelledById String? @db.Uuid
 cancelRequestKey String? @db.Uuid
 warehouse Warehouse? @relation(fields:[companyId,warehouseId],references:[companyId,id])
 cancelledBy Membership? @relation("SaleCanceller",fields:[companyId,cancelledById],references:[companyId,id])
 movements StockMovement[]
 cashMovements CashMovement[]
 @@unique([companyId,requestKey])
 @@unique([companyId,cancelRequestKey])
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  branchId String @db.Uuid
  customerId String? @db.Uuid
  sellerId String @db.Uuid
  number Int
  status SaleStatus @default(QUOTE)
  total Decimal @db.Decimal(14,2)
  discount Decimal @default(0) @db.Decimal(14,2)
  createdAt DateTime @default(now())
  company Company @relation(fields:[companyId],references:[id])
  branch Branch @relation(fields:[companyId,branchId],references:[companyId,id])
  customer Customer? @relation(fields:[companyId,customerId],references:[companyId,id])
  seller Membership @relation("SaleSeller",fields:[companyId,sellerId],references:[companyId,id])
  items SaleItem[]
  payments Payment[]
  financialEntries FinancialEntry[]
  fiscalDocuments FiscalDocument[]
  @@unique([companyId,id])
  @@unique([companyId,number])
  @@index([companyId,status,createdAt])
}
model SaleItem {
  publisher String?
  returns ReturnItem[]
  @@unique([companyId,id])

  isbn String?
  author String?
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  saleId String @db.Uuid
  productId String @db.Uuid
  description String
  quantity Decimal @db.Decimal(14,3)
  unitPrice Decimal @db.Decimal(14,2)
  unitCost Decimal @db.Decimal(14,2)
  discount Decimal @default(0) @db.Decimal(14,2)
  sale Sale @relation(fields:[companyId,saleId],references:[companyId,id])
  product Product @relation(fields:[companyId,productId],references:[companyId,id])
  @@index([companyId,saleId])
}
enum PaymentMethod {
  CASH
  PIX
  DEBIT_CARD
  CREDIT_CARD
  BANK_SLIP
  STORE_CREDIT
  OTHER
}
model Payment {
 receivedAmount Decimal? @db.Decimal(14,2)
 change Decimal @default(0) @db.Decimal(14,2)
 installments Int @default(1)
 cardBrand String?
 reference String?
 reversedAt DateTime?
 financialEntries FinancialEntry[]
 cashMovements CashMovement[]
 @@unique([companyId,id])
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  saleId String @db.Uuid
  method PaymentMethod
  amount Decimal @db.Decimal(14,2)
  paidAt DateTime?
  sale Sale @relation(fields:[companyId,saleId],references:[companyId,id])
  @@index([companyId,saleId])
}
enum EntryType {
  RECEIVABLE
  PAYABLE
}
enum EntryStatus {
  OPEN
  SETTLED
  CANCELLED
}
model FinancialEntry {
  actions FinancialAction[]
  expectedDate DateTime? @db.Date
  notes String?
  externalReference String?
  obligationId String? @db.Uuid
  obligation FinancialObligation? @relation(fields:[companyId,obligationId],references:[companyId,id])
  interest Decimal @default(0) @db.Decimal(14,2)
  penalty Decimal @default(0) @db.Decimal(14,2)
  discount Decimal @default(0) @db.Decimal(14,2)
  settlements FinancialSettlement[]
  @@unique([companyId,obligationId,installment])

 settledAmount Decimal @default(0) @db.Decimal(14,2)
  returnId String? @db.Uuid
  returnOperation ReturnOperation? @relation(fields:[companyId,returnId],references:[companyId,id])

 branchId String? @db.Uuid
 paymentId String? @db.Uuid
 installment Int?
 branch Branch? @relation(fields:[companyId,branchId],references:[companyId,id])
 payment Payment? @relation(fields:[companyId,paymentId],references:[companyId,id])
 @@unique([companyId,paymentId,installment])
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  saleId String? @db.Uuid
  customerId String? @db.Uuid
  supplierId String? @db.Uuid
  type EntryType
  status EntryStatus @default(OPEN)
  description String
  amount Decimal @db.Decimal(14,2)
  dueDate DateTime @db.Date
  settledAt DateTime?
  company Company @relation(fields:[companyId],references:[id])
  sale Sale? @relation(fields:[companyId,saleId],references:[companyId,id])
  customer Customer? @relation(fields:[companyId,customerId],references:[companyId,id])
  supplier Supplier? @relation(fields:[companyId,supplierId],references:[companyId,id])
  @@unique([companyId,id])
  @@index([companyId,type,status,dueDate])
}
model BankAccount {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  name String
  company Company @relation(fields:[companyId],references:[id])
  @@unique([companyId,id])
}
model CashRegister {
  sessions CashSession[]

 branchId String? @db.Uuid
 branch Branch? @relation(fields:[companyId,branchId],references:[companyId,id])
 @@unique([companyId,branchId,name])
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  name String
  company Company @relation(fields:[companyId],references:[id])
  movements CashMovement[]
  @@unique([companyId,id])
}
model CashMovement {
  cashSessionId String? @db.Uuid
  actorId String? @db.Uuid
  method PaymentMethod?
  requestKey String? @db.Uuid
  requestHash String?
  cashSession CashSession? @relation(fields:[companyId,cashSessionId],references:[companyId,id])
  actor Membership? @relation(fields:[companyId,actorId],references:[companyId,id])
  @@unique([companyId,requestKey])

 saleId String? @db.Uuid
 paymentId String? @db.Uuid
 kind String @default("LEGACY")
 sale Sale? @relation(fields:[companyId,saleId],references:[companyId,id])
 payment Payment? @relation(fields:[companyId,paymentId],references:[companyId,id])
 @@unique([companyId,paymentId,kind])
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  cashRegisterId String @db.Uuid
  amount Decimal @db.Decimal(14,2)
  description String
  createdAt DateTime @default(now())
  cashRegister CashRegister @relation(fields:[companyId,cashRegisterId],references:[companyId,id])
  @@index([companyId,createdAt])
}
enum FiscalDocumentType {
  NFE
  NFCE
  NFSE
  CTE
  MDFE
}
model FiscalDocument {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  saleId String? @db.Uuid
  type FiscalDocumentType
  providerReference String?
  status String @default("DRAFT")
  createdAt DateTime @default(now())
  company Company @relation(fields:[companyId],references:[id])
  sale Sale? @relation(fields:[companyId,saleId],references:[companyId,id])
  @@unique([companyId,id])
  @@index([companyId,createdAt])
}
model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  actorId String? @db.Uuid
  action String
  module String
  recordId String
  metadata Json?
  createdAt DateTime @default(now())
  company Company @relation(fields:[companyId],references:[id])
  actor Membership? @relation(fields:[companyId,actorId],references:[companyId,id])
  @@index([companyId,createdAt])
  @@index([companyId,module,recordId])
}

model ProductIdentifier {
 companyId String @db.Uuid
 value String
 productId String @db.Uuid
 product Product @relation(fields:[companyId,productId],references:[companyId,id],onDelete:Cascade)
 @@id([companyId,value])
 @@index([companyId,productId])
}
model StockDocument {
 purchaseReceipt PurchaseReceipt?
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 warehouseId String @db.Uuid
 actorId String @db.Uuid
 supplierId String? @db.Uuid
 kind String
 requestKey String @db.Uuid
 requestHash String
 documentNumber String?
 invoiceNumber String?
 receivedAt DateTime @db.Date
 notes String?
 createdAt DateTime @default(now())
 warehouse Warehouse @relation(fields:[companyId,warehouseId],references:[companyId,id])
 actor Membership @relation(fields:[companyId,actorId],references:[companyId,id])
 supplier Supplier? @relation(fields:[companyId,supplierId],references:[companyId,id])
 items StockDocumentItem[]
 movements StockMovement[]
 @@unique([companyId,id])
 @@unique([companyId,requestKey])
 @@index([companyId,createdAt])
}
model StockDocumentItem {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 documentId String @db.Uuid
 productId String @db.Uuid
 title String
 quantity Decimal @db.Decimal(14,3)
 unitCost Decimal @db.Decimal(14,2)
 document StockDocument @relation(fields:[companyId,documentId],references:[companyId,id])
 product Product @relation(fields:[companyId,productId],references:[companyId,id])
 @@unique([companyId,documentId,productId])
}

model CashSession {
 openingNotes String?
 closingNotes String?
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 branchId String @db.Uuid
 cashRegisterId String @db.Uuid
 openedById String @db.Uuid
 closedById String? @db.Uuid
 status String @default("OPEN")
 openedAt DateTime @default(now())
 closedAt DateTime?
 openingAmount Decimal @db.Decimal(14,2)
 expectedAmount Decimal? @db.Decimal(14,2)
 countedAmount Decimal? @db.Decimal(14,2)
 difference Decimal? @db.Decimal(14,2)
 closingSummary Json?
 notes String?
 requestKey String @db.Uuid
 requestHash String
 closeRequestKey String? @db.Uuid
 closeRequestHash String?
 company Company @relation(fields:[companyId],references:[id])
 branch Branch @relation(fields:[companyId,branchId],references:[companyId,id])
 cashRegister CashRegister @relation(fields:[companyId,cashRegisterId],references:[companyId,id])
 openedBy Membership @relation("CashOpener",fields:[companyId,openedById],references:[companyId,id])
 closedBy Membership? @relation("CashCloser",fields:[companyId,closedById],references:[companyId,id])
 sales Sale[]
 movements CashMovement[]
 returns ReturnOperation[]
 @@unique([companyId,id])
 @@unique([companyId,requestKey])
 @@unique([companyId,closeRequestKey])
 @@index([companyId,branchId,status])
}
model ReturnOperation {
  creditMovements CustomerCreditMovement[]
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 branchId String @db.Uuid
 warehouseId String @db.Uuid
 cashSessionId String @db.Uuid
 originalSaleId String @db.Uuid
 replacementSaleId String? @db.Uuid
 customerId String? @db.Uuid
 actorId String @db.Uuid
 number Int
 kind String
 reason String
 returnedAmount Decimal @db.Decimal(14,2)
 newAmount Decimal @db.Decimal(14,2)
 difference Decimal @db.Decimal(14,2)
 createdAt DateTime @default(now())
 requestKey String @db.Uuid
 requestHash String
 company Company @relation(fields:[companyId],references:[id])
 branch Branch @relation(fields:[companyId,branchId],references:[companyId,id])
 warehouse Warehouse @relation(fields:[companyId,warehouseId],references:[companyId,id])
 cashSession CashSession @relation(fields:[companyId,cashSessionId],references:[companyId,id])
 originalSale Sale @relation("OriginalSale",fields:[companyId,originalSaleId],references:[companyId,id])
 replacementSale Sale? @relation("ReplacementSale",fields:[companyId,replacementSaleId],references:[companyId,id])
 customer Customer? @relation(fields:[companyId,customerId],references:[companyId,id])
 actor Membership @relation(fields:[companyId,actorId],references:[companyId,id])
 items ReturnItem[]
 movements StockMovement[]
 financialEntries FinancialEntry[]
 credit CustomerCredit?
 @@unique([companyId,id])
 @@unique([companyId,number])
 @@unique([companyId,requestKey])
 @@unique([companyId,replacementSaleId])
 @@index([companyId,originalSaleId])
 @@index([companyId,branchId,createdAt])
}
model ReturnItem {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 returnId String @db.Uuid
 saleItemId String @db.Uuid
 quantity Int
 amount Decimal @db.Decimal(14,2)
 returnOperation ReturnOperation @relation(fields:[companyId,returnId],references:[companyId,id])
 saleItem SaleItem @relation(fields:[companyId,saleItemId],references:[companyId,id])
 @@unique([companyId,returnId,saleItemId])
 @@index([companyId,saleItemId])
}
model CustomerCredit {
  creditMovements CustomerCreditMovement[]
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 customerId String @db.Uuid
 returnId String @db.Uuid
 amount Decimal @db.Decimal(14,2)
 balance Decimal @db.Decimal(14,2)
 status String @default("AVAILABLE")
 createdAt DateTime @default(now())
 company Company @relation(fields:[companyId],references:[id])
 customer Customer @relation(fields:[companyId,customerId],references:[companyId,id])
 returnOperation ReturnOperation @relation(fields:[companyId,returnId],references:[companyId,id])
 @@unique([companyId,id])
 @@unique([companyId,returnId])
 @@index([companyId,customerId,status])
}

model CustomerCreditMovement {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 creditId String @db.Uuid
 customerId String @db.Uuid
 actorId String @db.Uuid
 saleId String? @db.Uuid
 returnId String @db.Uuid
 kind String
 amount Decimal @db.Decimal(14,2)
 beforeBalance Decimal @db.Decimal(14,2)
 afterBalance Decimal @db.Decimal(14,2)
 createdAt DateTime @default(now())
 company Company @relation(fields:[companyId],references:[id])
 credit CustomerCredit @relation(fields:[companyId,creditId],references:[companyId,id])
 customer Customer @relation(fields:[companyId,customerId],references:[companyId,id])
 actor Membership @relation(fields:[companyId,actorId],references:[companyId,id])
 sale Sale? @relation(fields:[companyId,saleId],references:[companyId,id])
 returnOperation ReturnOperation @relation(fields:[companyId,returnId],references:[companyId,id])
 @@unique([companyId,creditId,saleId,kind])
 @@index([companyId,customerId,createdAt])
}

model Event {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 branchId String @db.Uuid
 responsibleId String @db.Uuid
 warehouseId String @db.Uuid
 transitWarehouseId String @db.Uuid
 code String
 name String
 description String?
 type String
 startsAt DateTime @db.Date
 endsAt DateTime @db.Date
 location String
 city String
 state String
 notes String?
 status String @default("DRAFT")
